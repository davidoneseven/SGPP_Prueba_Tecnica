@page "/"

<PageTitle>Home</PageTitle>

<h1>Sistema de gestión de Proveedores y Productos</h1>

<hr/>

<div class="container my-4">
    <div class="d-flex justify-content-around">
        
        <NavLink class="text-decoration-none" href="/proveedores">
            <div class="card text-bg-dark card-custom">
                <img src="img/provider.svg" class="card-img" alt="...">
                <div class="card-img-overlay">
                    <h3 class="card-title">Proveedores</h3>
                </div>
            </div>
        </NavLink>

        <NavLink class="text-decoration-none" href="/productos">
            <div class="card text-bg-dark card-custom">
                <img src="img/product.svg" class="card-img" alt="...">
                <div class="card-img-overlay">
                    <h3 class="card-title">Productos</h3>
                </div>
            </div>
        </NavLink>

        <NavLink class="text-decoration-none" href="/abastecimiento">
            <div class="card text-bg-dark card-custom">
                <img src="img/relation.svg" class="card-img" alt="...">
                <div class="card-img-overlay">
                    <h3 class="card-title">Abastecimiento</h3>
                </div>
            </div>
        </NavLink>

    </div>
</div>
